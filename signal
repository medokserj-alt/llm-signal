#!/usr/bin/env bash
set -euo pipefail

PYTHON_BIN="${SIGNAL_PYTHON_BIN:-$(dirname "$0")/.venv/bin/python3}"

if [[ ! -x "$PYTHON_BIN" ]]; then
  # fallback на системный python3, если venv по какой-то причине не найден
  PYTHON_BIN="python3"
fi

cd "$(dirname "$0")"
LOGS_DIR="${SIGNAL_LOGS_DIR:-logs}"
mkdir -p "$LOGS_DIR"

MODEL="${OPENAI_MODEL:-gpt-5.2}"
PARAMS="params.json"
is_full_run=0

# Разбор аргументов: "./signal full" | "./signal LINK"
args=()
if [[ $# -gt 0 ]]; then
  if [[ "$1" == "full" ]]; then
    shift
    is_full_run=1
    args+=(--multi)
  elif [[ "$1" != -* && $# -eq 1 ]]; then
    args+=(--symbol "$1")
    shift
  fi
fi
args+=("$@")

ts=$(TZ=Europe/Moscow date +%Y%m%d_%H%M%S)
run_log="$LOGS_DIR/signal_${ts}.log"
run_last_json="$LOGS_DIR/last_${ts}.json"
canonical_last_json="$LOGS_DIR/last.json"
run_signal_html="signal_${ts}.html"
run_stream_tmp="$LOGS_DIR/stream_${ts}.tmp"
run_last_raw_json="$LOGS_DIR/last_${ts}.raw.json"
run_last_clean_json="$LOGS_DIR/last_${ts}.clean.json"
canonical_stream_tmp="$LOGS_DIR/stream.tmp"
canonical_last_raw_json="$LOGS_DIR/last.raw.json"
canonical_last_clean_json="$LOGS_DIR/last.clean.json"

# 1) Генерация + запись логов (сырой поток)
# --- Step8: refresh LESSONS and export path ---
./lessons_block.py >/dev/null 2>&1 || true
export LLM_LESSONS_FILE="$PWD/auto_feedback/lessons/LESSONS_FOR_LLM.md"

"$PYTHON_BIN" get_signal_json.py --model "$MODEL" --params "$PARAMS" "${args[@]}" \
  | tee "$run_log" \
  | tee -a "$LOGS_DIR/last_signal.log" \
  > "$run_stream_tmp"

# 2) Извлечь ПОСЛЕДНИЙ валидный JSON из лога (баланс скобок, игнорируя строки и экранирования)
export SIGNAL_RUN_LAST_JSON="$run_last_json"
export SIGNAL_RUN_LOG="$run_log"
export SIGNAL_STREAM_TMP="$run_stream_tmp"
export SIGNAL_LOGS_DIR="$LOGS_DIR"
export SIGNAL_LAST_RAW_JSON="$run_last_raw_json"
export SIGNAL_LAST_CLEAN_JSON="$run_last_clean_json"
python3 - << 'PY'
import json, os, re, pathlib, sys

def sanitize(s: str) -> str:
    # убрать код-фенсы и BOM/CR
    s = s.replace("\ufeff", "")
    s = s.replace("\r", "")
    s = re.sub(r'^\s*```json\s*', '', s, flags=re.IGNORECASE | re.MULTILINE)
    s = re.sub(r'\s*```\s*$', '', s)
    # вылечить висячие запятые перед } ]
    for _ in range(5):
        s2 = re.sub(r',\s*([}\]])', r'\1', s)
        if s2 == s:
            break
        s = s2
    return s.strip()

def find_json_candidates(text: str):
    # Вырезаем все “сырцы” между балансными { ... }
    # Учитываем строки/экранирование
    candidates = []
    n = len(text)
    i = 0
    while i < n:
        if text[i] == '{':
            depth = 0
            j = i
            in_str = False
            esc = False
            while j < n:
                ch = text[j]
                if in_str:
                    if esc:
                        esc = False
                    elif ch == '\\':
                        esc = True
                    elif ch == '"':
                        in_str = False
                else:
                    if ch == '"':
                        in_str = True
                    elif ch == '{':
                        depth += 1
                    elif ch == '}':
                        depth -= 1
                        if depth == 0:
                            # кандидат найден
                            candidates.append(text[i:j+1])
                            i = j
                            break
                j += 1
        i += 1
    return candidates

logs_dir = pathlib.Path(os.environ.get("SIGNAL_LOGS_DIR", "logs"))
run_last_json = pathlib.Path(os.environ.get("SIGNAL_RUN_LAST_JSON", "logs/last.json"))
run_log = pathlib.Path(os.environ.get("SIGNAL_RUN_LOG", ""))
last_raw_json = pathlib.Path(os.environ.get("SIGNAL_LAST_RAW_JSON", "logs/last.raw.json"))
last_clean_json = pathlib.Path(os.environ.get("SIGNAL_LAST_CLEAN_JSON", "logs/last.clean.json"))
log_path = pathlib.Path(os.environ.get("SIGNAL_STREAM_TMP", "logs/stream.tmp"))
raw = log_path.read_text(encoding="utf-8", errors="ignore")

# Пытаемся сначала по свежему per-run потоку; если пусто — берём только текущий run_log.
cands = find_json_candidates(raw)
if not cands and run_log.exists():
    raw2 = run_log.read_text(encoding="utf-8", errors="ignore")
    cands = find_json_candidates(raw2)

ok = None
errors = []
for chunk in reversed(cands):  # берём последний валидный
    s = sanitize(chunk)
    if not s:
        continue
    try:
        data = json.loads(s)
        ok = (data, s)
        break
    except Exception as e:
        # пробуем ещё раз после дополнительной зачистки редких артефактов:
        s2 = re.sub(r'^\s*json\s*:\s*', '', s, flags=re.IGNORECASE)
        s2 = re.sub(r'^\s*{[^"\n]*:\s*$', '', s2)  # обрубки
        try:
            data = json.loads(s2)
            ok = (data, s2)
            break
        except Exception as e2:
            errors.append((e, s[:120] + ('...' if len(s) > 120 else '')))

if ok is None:
    last_raw_json.write_text(raw, encoding="utf-8")
    last_clean_json.write_text("", encoding="utf-8")
    sys.stderr.write(f"[FATAL] JSON not found/parsed; wrote {last_raw_json} for debugging\n")
    sys.exit(2)

data, clean = ok

def _drop_time_window_mentions(obj):
    mode = str(obj.get("mode") or "").strip().lower()
    if mode != "aggressive":
        return obj

    def has_tw(s: str) -> bool:
        return "time_window" in s

    def walk(x):
        if isinstance(x, dict):
            for k in list(x.keys()):
                v = x[k]
                if k == "no_trade_reasons" and isinstance(v, list):
                    x[k] = [it for it in v if not (isinstance(it, str) and has_tw(it))]
                    continue
                if k == "warnings" and isinstance(v, list):
                    x[k] = [it for it in v if not (isinstance(it, str) and has_tw(it))]
                    continue
                if k in ("no_trade_hint", "comments") and isinstance(v, str) and has_tw(v):
                    x[k] = ""
                    continue
                if k == "comment" and isinstance(v, str) and has_tw(v):
                    x[k] = ""
                    continue
                walk(v)
        elif isinstance(x, list):
            for it in x:
                walk(it)

    try:
        walk(obj)
    except Exception:
        pass
    return obj

data = _drop_time_window_mentions(data)
last_raw_json.write_text(clean, encoding="utf-8")
last_clean_json.write_text(clean, encoding="utf-8")
run_last_json.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
print(f"[OK] extracted + validated JSON -> {run_last_json}")
PY

cp -f "$run_stream_tmp" "$canonical_stream_tmp"
cp -f "$run_last_raw_json" "$canonical_last_raw_json"
cp -f "$run_last_clean_json" "$canonical_last_clean_json"

# --- генерируем артефакты для бота (MD + HTML) ---
last_json="$run_last_json"

# Анализ (MD) поверх логов
"$PYTHON_BIN" save_analysis_text.py < "$run_log" | tee -a "$run_log" || true

# Прогоняем JSON через v2-постобработку (EMA/H1 + DAY/MID + ADX + три входа)
"$PYTHON_BIN" postprocess_full_last.py --last-json "$last_json" >> "$run_log" 2>&1 || echo "[WARN] postprocess_full_last failed" >> "$run_log"

if [[ "$is_full_run" == "1" && "${SIGNAL_SKIP_AIA_SEND:-0}" != "1" ]]; then
  "$PYTHON_BIN" send_last_signal_to_aia.py "$run_log" --last-json "$last_json" | tee -a "$run_log" || true
fi

cp -f "$last_json" "$canonical_last_json"

# HTML-сигнал из v2 JSON
"$PYTHON_BIN" render_strict.py --output "$run_signal_html" < "$last_json" 2>&1 | tee -a "$run_log" || true

echo "----------------------------------------"
echo "✅ Saved logs: $run_log"
echo "✅ Last JSON:  $canonical_last_json"
if [[ -f "$run_signal_html" ]]; then
  echo "✅ Signal HTML: $run_signal_html"
else
  echo "⚠️ Signal HTML was not created for this run"
fi

# --- Show tail of run log to terminal (optional) ---
LINES="${LOG_TAIL:-120}"
echo
echo "**Хвост лога (последние ${LINES} строк):**"
tail -n "${LINES}" "$run_log"
